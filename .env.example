# NQ Pause-Board — lokale Umgebungsvariablen fürs Testen des Skripts
#
# Kopiere diese Datei nach ".env" und trage deinen Key ein:
#   cp .env.example .env
#
# Danach das Skript lokal ausführen (Node 20+):
#   node --env-file=.env scripts/fetch-assessment.mjs
#
# ".env" ist über .gitignore ausgeschlossen und wird NIE eingecheckt.

# Erforderlich: Anthropic API-Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Modell überschreiben (Default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
