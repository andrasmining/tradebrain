{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrasmining.github.io/tradebrain/schemas/risk-state.schema.json",
  "title": "TradeBrain provider risk state",
  "type": "object",
  "required": ["schemaVersion","provider","engineVersion","promptVersion","generatedAt","market","instruments","status","statusText","recommendation","headline","body","tailRiskPct","tailLevel","stressRiskPct","stressLevel","dominantMode","confidencePct","confidenceLevel","action","dangerWindow","dangerWindowBerlin","sources","lookbackSummary","lookback","outlookSummary","forecast","forecastDetail","events"],
  "properties": {
    "schemaVersion": {"const":"1.0.0"},
    "provider": {"type":"string","minLength":1},
    "engineVersion": {"type":"string","minLength":1},
    "promptVersion": {"type":"string","minLength":1},
    "generatedAt": {"type":"string","format":"date-time"},
    "market": {"const":"NASDAQ-100"},
    "instruments": {"const":["NQ_FUTURES","NAS100_CFD"]},
    "status": {"enum":["green","yellow","orange","red"]},
    "statusText": {"type":"string","minLength":1},
    "recommendation": {"type":"string","minLength":1},
    "headline": {"type":"string","minLength":1},
    "body": {"type":"string","minLength":1},
    "tailRiskPct": {"type":"integer","minimum":0,"maximum":100},
    "tailLevel": {"enum":["low","watch","elevated","high","critical"]},
    "stressRiskPct": {"type":"integer","minimum":0,"maximum":100},
    "stressLevel": {"enum":["low","moderate","elevated","high","extreme"]},
    "dominantMode": {"enum":["trend-up","trend-down","event/whipsaw","mixed","normal"]},
    "confidencePct": {"type":"integer","minimum":0,"maximum":100},
    "confidenceLevel": {"enum":["low","medium-low","solid","high","very-high"]},
    "action": {"enum":["EA_ON","WATCH","BLOCK_NEW_BASE_ENTRIES","STRONG_BLOCK_NO_NEW_RISK","EA_OFF_NO_NEW_RISK"]},
    "dangerWindow": {"$ref":"#/$defs/window"},
    "dangerWindowBerlin": {"$ref":"#/$defs/window"},
    "sources": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}},
    "lookbackSummary": {"type":"string"},
    "lookback": {"type":"array","minItems":24,"maxItems":24,"items":{"$ref":"#/$defs/lookback"}},
    "outlookSummary": {"type":"string"},
    "forecast": {"type":"array","minItems":24,"maxItems":24,"items":{"$ref":"#/$defs/forecast"}},
    "forecastDetail": {"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/detail"}},
    "events": {"type":"array","items":{"$ref":"#/$defs/event"}}
  },
  "$defs": {
    "window": {"type":"object","required":["start","end"],"properties":{"start":{"type":["string","null"]},"end":{"type":["string","null"]}},"additionalProperties":false},
    "source": {"type":"object","required":["title","url"],"properties":{"title":{"type":"string","minLength":1},"url":{"type":"string","format":"uri"}},"additionalProperties":true},
    "lookback": {"type":"object","required":["ts","timeBerlin","available","status","action","tailRiskPct","stressRiskPct","confidencePct","dominantMode"],"additionalProperties":true},
    "forecast": {"type":"object","required":["ts","timeBerlin","status","action","tailRiskPct","stressRiskPct","confidencePct","dominantMode"],"additionalProperties":true},
    "detail": {"type":"object","required":["ts","timeBerlin","status","tailRiskPct","stressRiskPct","comment"],"additionalProperties":true},
    "event": {"type":"object","required":["name","ts","timeBerlin","impact"],"properties":{"impact":{"enum":["high","medium"]}},"additionalProperties":true}
  },
  "additionalProperties": true
}
