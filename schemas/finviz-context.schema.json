{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://andrasmining.github.io/tradebrain/schemas/finviz-context.schema.json",
  "title": "TradeBrain shared Finviz context",
  "description": "Supplementary, deterministic market context. This document is not a provider assessment or trading signal.",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "generatedAt",
    "freshnessMinutes",
    "collectionStatus",
    "warnings",
    "library",
    "calendar",
    "breadth",
    "megacaps",
    "semiconductors",
    "futures",
    "earnings",
    "news"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "source": {"const": "finviz"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "freshnessMinutes": {"type": "integer", "minimum": 1, "maximum": 360},
    "collectionStatus": {"enum": ["ok", "partial"]},
    "warnings": {
      "type": "array",
      "maxItems": 30,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "library": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "finvizfinance"},
        "version": {"const": "1.3.0"}
      },
      "additionalProperties": false
    },
    "calendar": {"$ref": "#/$defs/calendarSection"},
    "breadth": {"$ref": "#/$defs/breadthSection"},
    "megacaps": {"$ref": "#/$defs/basketSection"},
    "semiconductors": {"$ref": "#/$defs/basketSection"},
    "futures": {"$ref": "#/$defs/futuresSection"},
    "earnings": {"$ref": "#/$defs/earningsSection"},
    "news": {"$ref": "#/$defs/newsSection"}
  },
  "$defs": {
    "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"},
    "changePct": {"type": "number", "minimum": -100, "maximum": 10000},
    "nullableAggregate": {
      "anyOf": [
        {"type": "number", "minimum": -100, "maximum": 10000},
        {"type": "null"}
      ]
    },
    "calendarEvent": {
      "type": "object",
      "required": ["rawDateTime", "release", "impact", "rawImpact", "period", "actual", "expected", "prior"],
      "properties": {
        "rawDateTime": {"type": "string", "minLength": 1, "maxLength": 120},
        "release": {"type": "string", "minLength": 1, "maxLength": 300},
        "impact": {"enum": ["high", "medium"]},
        "rawImpact": {"type": "string", "minLength": 1, "maxLength": 40},
        "category": {"type": "string", "maxLength": 120},
        "sourceTicker": {"type": "string", "maxLength": 120},
        "period": {"type": "string", "maxLength": 120},
        "actual": {"type": "string", "maxLength": 120},
        "expected": {"type": "string", "maxLength": 120},
        "prior": {"type": "string", "maxLength": 120}
      },
      "additionalProperties": false
    },
    "calendarSection": {
      "type": "object",
      "required": ["available", "availabilityStatus", "timezoneStatus", "timezoneNote", "events"],
      "properties": {
        "available": {"type": "boolean"},
        "availabilityStatus": {"enum": ["available", "empty", "unavailable"]},
        "timezoneStatus": {"const": "unverified"},
        "timezoneNote": {"type": "string", "minLength": 1, "maxLength": 300},
        "events": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/calendarEvent"}}
      },
      "additionalProperties": false
    },
    "breadthItem": {
      "type": "object",
      "required": ["name", "rawName", "changePct"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "rawName": {"type": "string", "minLength": 1, "maxLength": 160},
        "changePct": {"$ref": "#/$defs/changePct"}
      },
      "additionalProperties": false
    },
    "breadthSection": {
      "type": "object",
      "required": ["available", "performanceBasis", "sourceAsOfStatus", "realTimePricePath", "sectorAvailable", "industryAvailable", "sectors", "industries"],
      "properties": {
        "available": {"type": "boolean"},
        "performanceBasis": {"const": "latest-session"},
        "sourceAsOfStatus": {"const": "not-provided"},
        "realTimePricePath": {"const": false},
        "sectorAvailable": {"type": "boolean"},
        "industryAvailable": {"type": "boolean"},
        "sectors": {"type": "array", "maxItems": 30, "items": {"$ref": "#/$defs/breadthItem"}},
        "industries": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/breadthItem"}}
      },
      "additionalProperties": false
    },
    "basketItem": {
      "type": "object",
      "required": ["symbol", "changePct"],
      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "price": {"type": "number", "minimum": 0, "maximum": 10000000},
        "changePct": {"$ref": "#/$defs/changePct"}
      },
      "additionalProperties": false
    },
    "basketSection": {
      "type": "object",
      "required": [
        "available",
        "performanceBasis",
        "sourceAsOfStatus",
        "realTimePricePath",
        "coverageStatus",
        "symbolsRequested",
        "missingSymbols",
        "items",
        "availableCount",
        "positiveCount",
        "negativeCount",
        "unchangedCount",
        "positivePct",
        "meanChangePct",
        "medianChangePct",
        "dispersionPct"
      ],
      "properties": {
        "available": {"type": "boolean"},
        "performanceBasis": {"const": "latest-session"},
        "sourceAsOfStatus": {"const": "not-provided"},
        "realTimePricePath": {"const": false},
        "coverageStatus": {"enum": ["complete", "partial", "unavailable"]},
        "symbolsRequested": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
        "missingSymbols": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
        "items": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/basketItem"}},
        "availableCount": {"type": "integer", "minimum": 0},
        "positiveCount": {"type": "integer", "minimum": 0},
        "negativeCount": {"type": "integer", "minimum": 0},
        "unchangedCount": {"type": "integer", "minimum": 0},
        "positivePct": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 100},
            {"type": "null"}
          ]
        },
        "meanChangePct": {"$ref": "#/$defs/nullableAggregate"},
        "medianChangePct": {"$ref": "#/$defs/nullableAggregate"},
        "dispersionPct": {
          "anyOf": [
            {"type": "number", "minimum": 0, "maximum": 10000},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "futureItem": {
      "type": "object",
      "required": ["symbol", "label", "group", "changePct"],
      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "group": {"type": "string", "maxLength": 120},
        "changePct": {"$ref": "#/$defs/changePct"}
      },
      "additionalProperties": false
    },
    "futuresSection": {
      "type": "object",
      "required": ["available", "coverageStatus", "symbolsRequested", "missingSymbols", "delayedContextOnly", "usage", "items"],
      "properties": {
        "available": {"type": "boolean"},
        "coverageStatus": {"enum": ["complete", "partial", "unavailable"]},
        "symbolsRequested": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
        "missingSymbols": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/symbol"}},
        "delayedContextOnly": {"const": true},
        "usage": {"const": "supporting-context-only"},
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/futureItem"}}
      },
      "additionalProperties": false
    },
    "earningsItem": {
      "type": "object",
      "required": ["symbol", "rawDateTime", "date", "dateResolution", "daysUntil"],
      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "rawDateTime": {"type": "string", "minLength": 1, "maxLength": 120},
        "date": {"type": "string", "format": "date"},
        "dateResolution": {"enum": ["source-year", "year-inferred"]},
        "daysUntil": {"type": "integer", "minimum": 0, "maximum": 366},
        "rawTimingCode": {"type": "string", "minLength": 1, "maxLength": 20}
      },
      "additionalProperties": false
    },
    "earningsSection": {
      "type": "object",
      "required": ["available", "availabilityStatus", "lookaheadDays", "items"],
      "properties": {
        "available": {"type": "boolean"},
        "availabilityStatus": {"enum": ["available", "empty", "unavailable"]},
        "lookaheadDays": {"type": "integer", "minimum": 1, "maximum": 366},
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/earningsItem"}}
      },
      "additionalProperties": false
    },
    "newsItem": {
      "type": "object",
      "required": ["rawDateTime", "headline", "source", "url"],
      "properties": {
        "rawDateTime": {"type": "string", "maxLength": 120},
        "headline": {"type": "string", "minLength": 1, "maxLength": 500},
        "source": {"type": "string", "maxLength": 160},
        "url": {"type": "string", "format": "uri", "pattern": "^https?://"}
      },
      "additionalProperties": false
    },
    "newsSection": {
      "type": "object",
      "required": ["available", "availabilityStatus", "discoveryOnly", "items"],
      "properties": {
        "available": {"type": "boolean"},
        "availabilityStatus": {"enum": ["available", "empty", "unavailable"]},
        "discoveryOnly": {"const": true},
        "items": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/newsItem"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
